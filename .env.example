# Copy to .env.local (ignored by Git) and fill in. Read by the backend at startup.
AIHUBMIX_API_KEY=
# Models shown in VLM Run, comma-separated; the first is the default.
# Keep in line with the key's model scope in the AIHubMix console.
VLM_MODELS=qwen3-vl-plus
# AIHubMix chat/completions endpoint.
VLM_API_URL=https://aihubmix.com/v1/chat/completions
